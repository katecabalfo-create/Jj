# Puerto HTTP
PORT=3000
# URL pública del sitio (se usa en los emails y el sitemap)
BASE_URL=https://maldonadooportunidades.com
# Contraseña del panel /admin/  (¡cambiala!)
ADMIN_PASSWORD=cambiar-esta-clave
# Secreto para firmar la sesión del panel (cualquier texto largo y aleatorio)
SESSION_SECRET=
# Base de datos SQLite
DB_FILE=./data/maldonado.db
# 0 = no cargar avisos de ejemplo la primera vez
SEED=1
# Correo para enviar alertas (ej. Gmail con "contraseña de aplicación", Brevo, Mailgun…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Maldonado Oportunidades <avisos@maldonadooportunidades.com>"

# ---------- Pagos ----------
# Mercado Pago: Access Token de producción (Tus integraciones → Credenciales)
MP_ACCESS_TOKEN=
# Clave secreta de webhooks de Mercado Pago (opcional, recomendado)
MP_WEBHOOK_SECRET=
# 1 = usar el checkout de pruebas (sandbox) de Mercado Pago
MP_USE_SANDBOX=0
# 1 = habilita "pago de prueba" para probar el flujo sin cobrar (¡no usar en producción!)
PAYMENTS_DEMO=0
